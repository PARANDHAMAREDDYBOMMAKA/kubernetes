# Your Docker Hub username — images are pulled from here.
DOCKERHUB_USERNAME=yourhub

# Hostname Caddy serves + gets TLS cert for.
# Without a domain, use sslip.io: <droplet-ip>.sslip.io (e.g. 203.0.113.5.sslip.io)
# If you have a domain, put it here instead (e.g. kaas.example.com).
SITE_HOST=REPLACE_WITH_DROPLET_IP.sslip.io
